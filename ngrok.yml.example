# Plantilla de configuración de ngrok para exponer la app durante pruebas con
# Mercado Pago usando UN SOLO túnel (plan gratuito = un dominio).
#
# El túnel apunta al dev server del frontend (Vite, puerto 5173). Vite reenvía
# las rutas /api al backend (puerto 8080) mediante su proxy, así el webhook, los
# back_urls y las llamadas del front comparten el mismo dominio público.
#
# 1. Copia este archivo a "ngrok.yml".
# 2. Pon tu authtoken (https://dashboard.ngrok.com/get-started/your-authtoken).
# 3. Pon tu dominio fijo reservado (https://dashboard.ngrok.com/domains).
# 4. Levanta el túnel:  ngrok start app --config ngrok.yml
version: "3"
agent:
  authtoken: TU_AUTHTOKEN_DE_NGROK
tunnels:
  app:
    proto: http
    addr: 5173
    domain: TU-DOMINIO.ngrok-free.dev
